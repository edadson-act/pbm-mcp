# Upstream auth applied when this server calls a PBM API.
# none | api-key | bearer-env | forward | client-credentials
# client-credentials is a config slot only. Selecting it skips that API
# until the token request is implemented.
PBM_AUTH_MODE=none
PBM_API_KEY=
PBM_API_KEY_HEADER=x-api-key
PBM_BEARER_TOKEN=
PBM_TOKEN_URL=
PBM_CLIENT_ID=
PBM_CLIENT_SECRET=

# Callers of /mcp must send this secret as Authorization: Bearer <token>.
# Required before `tailscale funnel`. Leave empty for local-only use.
# Generate one with: openssl rand -hex 32
PBM_MCP_BEARER_TOKEN=

# This process binds localhost. Tailscale Funnel publishes that port.
PBM_HOST=127.0.0.1
PBM_PORT=8000
PBM_TIMEOUT_SECONDS=30
PBM_SPECS_DIR=specs
PBM_ALLOWLISTS_DIR=allowlists

# Per-API base URL is required before that API's tools are mounted.
# AUTH_MODE overrides PBM_AUTH_MODE for that API only.
# The same prefix accepts API_KEY, API_KEY_HEADER, and BEARER_TOKEN.
# Commented URLs are the local pbm-mock. Leave the values empty until you opt in.
# http://127.0.0.1:8001/v1/health-opportunity/graphql
PBM_HEALTH_OPPORTUNITY_BASE_URL=
PBM_HEALTH_OPPORTUNITY_AUTH_MODE=
# http://127.0.0.1:8001/v1/member-profile/graphql
PBM_MEMBER_PROFILE_BASE_URL=
PBM_MEMBER_PROFILE_AUTH_MODE=
# http://127.0.0.1:8001/v1/drug-search/graphql
PBM_DRUG_SEARCH_BASE_URL=
PBM_DRUG_SEARCH_AUTH_MODE=
# http://127.0.0.1:8001/v1/formulary/graphql
PBM_FORMULARY_BASE_URL=
PBM_FORMULARY_AUTH_MODE=
# http://127.0.0.1:8001/v1/claim-history/graphql
PBM_CLAIM_HISTORY_BASE_URL=
PBM_CLAIM_HISTORY_AUTH_MODE=
# http://127.0.0.1:8001/v1/savings-center/graphql
PBM_SAVINGS_CENTER_BASE_URL=
PBM_SAVINGS_CENTER_AUTH_MODE=
# http://127.0.0.1:8001/v1/pharmacy-search/graphql
PBM_PHARMACY_SEARCH_BASE_URL=
PBM_PHARMACY_SEARCH_AUTH_MODE=
# http://127.0.0.1:8001/v1/accumulators/graphql
PBM_ACCUMULATORS_BASE_URL=
PBM_ACCUMULATORS_AUTH_MODE=
# http://127.0.0.1:8001/v1/prior-auth/graphql
PBM_PRIOR_AUTH_BASE_URL=
PBM_PRIOR_AUTH_AUTH_MODE=
# http://127.0.0.1:8001/v1/drug-pricing/graphql
PBM_DRUG_PRICING_BASE_URL=
PBM_DRUG_PRICING_AUTH_MODE=
# http://127.0.0.1:8001/v1/id-card/graphql
PBM_ID_CARD_BASE_URL=
PBM_ID_CARD_AUTH_MODE=
# http://127.0.0.1:8001/v1/member-consent/graphql
PBM_MEMBER_CONSENT_BASE_URL=
PBM_MEMBER_CONSENT_AUTH_MODE=
